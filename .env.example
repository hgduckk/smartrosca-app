# ---------------------------------------------------------------------------
# CHẾ ĐỘ MOCK (bản test giao diện)
# Bỏ trống / khác "false"  => MOCK bật: không cần ví MetaMask, blockchain hay DB.
#                             Ví luôn "đã kết nối", API trả dữ liệu mẫu, đăng nhập
#                             giả lập (nhập bất kỳ). Dùng để test toàn bộ giao diện.
# "false"                   => chạy code THẬT (ví + smart contract + Postgres).
NEXT_PUBLIC_MOCK_MODE=

# Kết nối Postgres (Supabase) — dùng connection string dạng
# postgresql://<user>:<password>@<host>:<port>/<db>?pgbouncer=true
# (Chỉ cần khi NEXT_PUBLIC_MOCK_MODE=false — bản test mock KHÔNG cần DATABASE_URL.)
DATABASE_URL=

# Sepolia testnet chainId
NEXT_PUBLIC_CHAIN_ID=11155111

# URL công khai khi deploy (để phân giải ảnh OpenGraph/Twitter của PWA).
# Dev để trống cũng được (mặc định http://localhost:3000).
NEXT_PUBLIC_SITE_URL=

# Ghi chú kiến trúc: MỖI dây hụi là MỘT contract riêng, được deploy ngay khi tạo
# dây (địa chỉ lưu vào HuiGroup.contractAddress trong DB). Vì vậy KHÔNG còn dùng
# biến NEXT_PUBLIC_CONTRACT_ADDRESS dùng chung như kiến trúc cũ.
